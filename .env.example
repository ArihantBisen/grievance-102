DATABASE_URL="postgresql://user:password@localhost:5432/sboss_grievance?schema=public"
PORT=4000
# Resolver/Admin Console JWT signing secret (Part E step 8). Generate a real one for
# anything beyond local dev, e.g.: openssl rand -base64 48
JWT_SECRET="replace-me-with-a-real-secret"

# WhatsApp Middleware (D2b) — Meta Cloud API direct, per ADR-003. Leave unset in dev:
# the Outbox Worker and the webhook handler both fall back to a logging stub
# (packages/whatsapp-client) that prints what would have been sent instead of calling
# Meta, so everything else works without these. Fill in once Business Verification /
# the permanent System User token exist (see the Meta setup dashboard: Phone Number ID
# and WABA ID are shown there once a number is claimed; the access token comes from
# Business Settings -> System Users, NOT the 24hr "temporary token" on the Try It Out
# screen).
META_ACCESS_TOKEN=""
META_PHONE_NUMBER_ID=""
META_API_VERSION="v20.0"
# HMAC secret Meta signs inbound webhook payloads with (App Settings -> Basic -> App
# Secret). Leave unset in dev to skip signature verification for local curl testing.
META_APP_SECRET=""
# Arbitrary string you choose and enter into Meta's webhook subscription dialog
# (Callback URL config) — Meta echoes it back on the GET handshake to prove you own
# the endpoint.
META_WEBHOOK_VERIFY_TOKEN="replace-me-with-a-random-string"
# Name/language of the single pre-approved utility template used for all TEMPLATE-path
# sends (outside WhatsApp's 24hr window) — see the drafted templates below. Submit
# these once the WhatsApp product's Message Templates page is reachable.
META_DEFAULT_TEMPLATE_NAME="sboss_ticket_update"
META_DEFAULT_TEMPLATE_LANGUAGE="en_US"

# Base URL of apps/website, used to build the link sent on WhatsApp (ADR-002's
# "entry point" flow). Defaults to the local Vite dev server if unset.
WEBSITE_BASE_URL="http://localhost:5173"

# File uploads (attachments). LocalDiskStorage (apps/api/src/lib/storage.ts) — swap for
# a real object store later without touching the upload route or anything that reads
# Attachment.fileUrl. UPLOAD_DIR defaults to ./uploads relative to apps/api's cwd
# (gitignored); API_BASE_URL must be reachable by whoever needs to fetch the returned
# fileUrl (the resolver console, mainly).
UPLOAD_DIR=""
API_BASE_URL="http://localhost:4000"
